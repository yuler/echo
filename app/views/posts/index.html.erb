<% filter_tabs = @posts.any? && @posts.count > 5 %>
<% recent_posts_inner = capture do %>
  <div class="mb-5 shrink-0">
    <span class="text-overline">Recent</span>
  </div>

  <div class="grid min-h-0 min-w-0 w-full grid-cols-1 gap-4 overflow-x-hidden pb-2 sm:gap-6 md:grid-cols-2 lg:grid-cols-3<%= " flex-1 overflow-y-auto" if filter_tabs %>">
    <% @posts.limit(5).each do |post| %>
      <%= render "posts/post_card", post: post %>
    <% end %>
  </div>
<% end %>

<div class="container-main<%= " flex min-h-0 flex-1 flex-col" if filter_tabs %>">
  <%# Top row %>
  <header class="mb-8 flex shrink-0 flex-row items-center justify-between">
    <h1 class="text-display">Posts</h1>
  </header>

  <% if @posts.any? %>
    <% if filter_tabs %>
      <div class="flex min-h-0 min-w-0 flex-1 flex-col">
        <section class="mb-8 flex min-h-0 min-w-0 flex-1 flex-col" aria-label="Recent posts">
          <%= recent_posts_inner %>
        </section>

        <%# Bottom row: topic filters %>
        <nav class="scrollbar-none mt-auto flex shrink-0 flex-row gap-5 overflow-x-auto border-b border-t border-neutral-200 py-4" aria-label="Filter posts by topic">
          <button type="button" class="posts-tab posts-tab-active">ALL</button>
          <% all_topics = @posts.flat_map(&:topics_list).uniq.first(6) %>
          <% all_topics.each do |topic| %>
            <button type="button" class="posts-tab"><%= topic.upcase %></button>
          <% end %>
        </nav>
      </div>
    <% else %>
      <section class="mb-8" aria-label="Recent posts">
        <%= recent_posts_inner %>
      </section>
    <% end %>
  <% else %>
    <div class="flex flex-1 flex-col items-center justify-center py-16" style="color: #a3a3a3">
      <p class="text-body-lg">No posts yet</p>
    </div>
  <% end %>
</div>
